ANTHROPIC_API_KEY=your_key_here
# Optional model override
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Set true to skip Anthropic web search (useful if your key returns 403 for tools)
# ANTHROPIC_DISABLE_WEB_SEARCH=false
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./thesis.db
FRONTEND_URL=http://localhost:5173

# Optional: enable real verification emails. If unset, the app prints/shows a local verify link.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
